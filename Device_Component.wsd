@startuml C4_Component_Unified
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(app_api, "API Gateway", "Go", "Единая точка входа, аутентификация, маршрутизация")

System_Boundary(device_boundary, "Управление устройствами") {
    Component(device_api, "Device API", "HTTP", "Единый API для всех устройств")
    Component(device_registry, "Реестр устройств", "Go", "Регистрация, статусы, метаданные")
    Component(device_command, "Командный процессор", "Go", "Маршрутизация команд на устройства")
    Component(device_provisioning, "Сервис подключения", "Go", "Самостоятельная регистрация")
    Component(device_connector, "Коннектор устройств", "Go", "Единая точка подключения к IoT")
    Component(telemetry_ingest, "Прием телеметрии", "Go", "Прием данных от устройств")
}

System_Boundary(business_boundary, "Сервисы бизнес-логики") {
    Component(heating_service, "Сервис отопления", "Go", "Логика термостатов, расписания")
    Component(lighting_service, "Сервис освещения", "Go", "Логика управления светом")
}

ContainerDb(device_db, "База устройств", "PostgreSQL", "Профили, статусы, подключения")
ContainerDb(business_db, "База бизнес-логики", "PostgreSQL", "Расписания, сценарии, настройки")
ContainerQueue(message_broker, "Брокер сообщений", "Kafka", "События устройств и команд")
System_Ext(iot_device, "IoT Устройства", "Датчики, реле, камеры")

Rel(app_api, device_api, "Запросы устройств", "HTTP")
Rel(app_api, heating_service, "Управление отоплением", "HTTP")
Rel(app_api, lighting_service, "Управление светом", "HTTP")

Rel(device_api, device_registry, "Запросы статусов", "HTTP")
Rel(device_api, device_command, "Отправка команд", "HTTP")
Rel(device_api, device_provisioning, "Регистрация", "HTTP")
Rel(device_provisioning, device_registry, "Добавление устройств", "HTTP")
Rel(device_command, device_connector, "Маршрутизация команд", "async")
Rel(device_connector, iot_device, "Протоколы устройств", "HTTP")
Rel(iot_device, telemetry_ingest, "Поток телеметрии", "HTTP")
Rel(telemetry_ingest, message_broker, "События телеметрии", "HTTP")

Rel(device_registry, device_db, "CRUD операций", "SQL")
Rel(heating_service, business_db, "Настройки отопления", "SQL")

Rel(heating_service, device_api, "Команды термостатам", "HTTP")
Rel(lighting_service, device_api, "Команды светильникам", "HTTP")
Rel(telemetry_ingest, message_broker, "События для бизнес-сервисов", "HTTP")
Rel(heating_service, message_broker, "Подписка на телеметрию", "HTTP")

@enduml